---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;

const sections = [
  { href: '/docs', label: 'Overview' },
  { href: '/docs/install', label: 'Install' },
  { href: '/docs/providers', label: 'Providers' },
  { href: '/docs/integrations', label: 'Desktop integrations' },
  { href: '/docs/http-api', label: 'HTTP API' },
  { href: '/docs/cli', label: 'CLI reference' },
];

const active = (href: string) => path === href;
---

<Layout title={title} description={description} path={path}>
  <div class="wrap docs-shell">
    <aside class="docs-side" aria-label="Documentation sections">
      <p class="eyebrow">Documentation</p>
      <ul>
        {sections.map((s) => (
          <li>
            <a href={s.href} class={active(s.href) ? 'active' : undefined}>{s.label}</a>
          </li>
        ))}
      </ul>
      <p class="eyebrow">Project</p>
      <ul>
        <li><a href="https://github.com/yan-ad/joocode" rel="noopener" target="_blank">GitHub ↗</a></li>
        <li><a href="https://github.com/yan-ad/joocode/releases" rel="noopener" target="_blank">Releases ↗</a></li>
      </ul>
    </aside>
    <article class="docs-body">
      <slot />
    </article>
  </div>
</Layout>

<style>
  .docs-shell {
    display: grid;
    gap: 2.5em;
    padding-top: 2.5em;
    padding-bottom: 3em;
  }
  @media (min-width: 820px) {
    .docs-shell { grid-template-columns: 220px 1fr; }
  }
  .docs-side { position: sticky; top: 86px; align-self: start; }
  .docs-side ul { list-style: none; padding: 0; margin: 0.3em 0 1.6em; }
  .docs-side li { margin: 0.15em 0; }
  .docs-side a {
    display: block;
    color: var(--ink-2);
    font-size: 0.94rem;
    padding: 0.28em 0.6em;
    border: none;
    border-radius: 8px;
  }
  .docs-side a:hover { color: var(--accent-strong); background: var(--accent-soft); }
  .docs-side a.active { color: var(--accent-strong); font-weight: 700; background: var(--accent-soft); }
  .docs-body { min-width: 0; max-width: 820px; }
  .docs-body h1 { margin-top: 0; }
  .docs-body h2 { border-top: 1px solid var(--border); padding-top: 1.4em; }
</style>
